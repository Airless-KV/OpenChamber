[node name="HSeparator" type="HSeparator" parent="OnboardingModal/Center/Panel/Margin/VBox"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="OnboardingModal/Center/Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="LoreContent" type="VBoxContainer" parent="OnboardingModal/Center/Panel/Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="LoreParagraph1" type="Label" parent="OnboardingModal/Center/Panel/Margin/VBox/Scroll/LoreContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.88, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 14
text = "Ten years ago, the Weeping Plague began to choke humanity. You didn't venture down into Carabao Island's sunken abyss to be a hero. You came for the payout: harvest the cure, get filthy rich, and buy your way into the pristine citadels of the high lords while the rest of the world rots outside the gates."
autowrap_mode = 2

[node name="LoreParagraph2" type="Label" parent="OnboardingModal/Center/Panel/Margin/VBox/Scroll/LoreContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 14
text = "• THE CURE (DAYTIME): Hidden deep in the canyon grows the glowing white flower known as the Waling-Waling. Plant fragile Level 1 seedlings on the chessboard dirt. Merge identical blooms to cultivate stronger, glowing strains of the cure, and haul your harvest to the trader's basket before dusk."
autowrap_mode = 2

[node name="LoreParagraph3" type="Label" parent="OnboardingModal/Center/Panel/Margin/VBox/Scroll/LoreContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "• THE SCAVENGER MERCHANT: The balloon trader holds the monopoly on your escape rope and intentionally bleeds you dry with extortionist taxes. In exchange for your blooms, he sells Before-Times relics: Seeds, CCTV Cameras, and Spark-Cell batteries."
autowrap_mode = 2

[node name="LoreParagraph4" type="Label" parent="OnboardingModal/Center/Panel/Margin/VBox/Scroll/LoreContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.35, 0.35, 1)
theme_override_font_sizes/font_size = 14
text = "• THE HORROR (NIGHTFALL): Your safehouse is a rotting shack bolted high into a colossal transmission tower with torn-away doors and windows. When darkness falls, the twisted Ani-Ani awake. Nail heavy Yero slabs across openings, keep your Spark-Cells charged, and monitor camera feeds to survive until dawn."
autowrap_mode = 2

[node name="HSeparator2" type="HSeparator" parent="OnboardingModal/Center/Panel/Margin/VBox"]
layout_mode = 2

