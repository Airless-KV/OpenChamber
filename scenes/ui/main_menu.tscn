text = "3. CONTROLS CHEAT SHEET"

[node name="Sec3Desc" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox" unique_id=967317822]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "• [W][A][S][D] : Move First-Person Player
• Mouse : Look Around
• Left Click : Primary Interact (Shop, Floodlight, CCTV Desk, Locks)
• Right Click : Secondary Action / Cancel Drag
• Hold Left Click (3s) : Place Barricade Plank
• Hold Right Click (3s) : Remove Barricade Plank
• In CCTV : Left Click (Switch Cam) | Right Click (Exit Desk)
• [ESC] : Pause Game (Freeze timers, adjust volume, or quit)"
autowrap_mode = 2

