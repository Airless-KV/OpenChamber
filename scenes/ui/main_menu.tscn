[node name="Sec1Title" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 17
text = "1. DAYTIME: CULTIVATION & PREPARATION"

[node name="Sec1Desc" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "• Plant Level 1 seeds on the chessboard field outside your cabin.
• Click adjacent identical flowers to MERGE them into higher tiers for exponential value.
• Sell harvested blooms at the Flower Shop to earn coins for seeds and upgrades.
• Keep an eye on the daytime countdown timer — when it reaches 00:00, night falls."
autowrap_mode = 2

[node name="Sec2Title" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.3, 0.3, 1)
theme_override_font_sizes/font_size = 17
text = "2. NIGHTTIME: SURVEILLANCE & HORROR DEFENSE"

[node name="Sec2Desc" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "• Enter your cabin and approach the security monitor desk. Press [E] (or hotkey [N]) to view CCTV feeds.
• Switch camera channels with [1 - 4] or [TAB] to inspect North, East, South, and West perimeters.
• The Ani-Ani entity stalks through 3 stages: Distant (far silhouette), Approaching (menacing glow), and Imminent (at your door/window!).
• Rush to close and secure doors and windows before the entity breaches your cabin!
• Survive 7 days and 7 nights to claim victory and eternal ranking."
autowrap_mode = 2

[node name="Sec3Title" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 0.95, 1)
theme_override_font_sizes/font_size = 17
text = "3. CONTROLS CHEAT SHEET"

[node name="Sec3Desc" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "• [W][A][S][D] : Move First-Person Player
• Mouse : Look Around
• [E] : Interact (Doors, Windows, Shop, CCTV Desk)
• [1-4 / TAB] : Switch CCTV Channels (North, East, South, West)
• [N / E] : Exit CCTV Desk
• [ESC] : Pause Game (Freeze timers, adjust volume, or quit)"
autowrap_mode = 2

[node name="CloseButton" type="Button" parent="Modals/HowToPlayModal/Panel/VBox"]
