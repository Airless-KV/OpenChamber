[node name="Sec1Desc" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox" unique_id=1086848893]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "• Plant Level 1 seeds on the chessboard field outside your cabin.
• Click adjacent identical flowers to MERGE them into higher tiers for exponential value.
• Sell harvested blooms at the Flower Shop to earn coins for seeds and upgrades.
• Keep an eye on the daytime countdown timer — when it reaches 00:00, night falls."
autowrap_mode = 2

[node name="Sec2Title" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox" unique_id=1149694684]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.3, 0.3, 1)
theme_override_font_sizes/font_size = 17
text = "2. NIGHTTIME: SURVEILLANCE & HORROR DEFENSE"

[node name="Sec2Desc" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox" unique_id=749760210]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "• Enter your cabin and approach the security monitor desk. Left Click to view CCTV feeds.
• Switch camera channels with Left Click (or [TAB] / [1 - 4]) to inspect North, East, South, and West perimeters.
• The Ani-Ani entity stalks through 3 stages: Distant (far silhouette), Approaching (menacing glow), and Imminent (at your cabin opening!).
• Rush to barricade bare openings with wooden planks (Hold Left Click 3s) before the entity breaches!
• Survive 7 days and 7 nights to claim victory and eternal ranking."
autowrap_mode = 2

[node name="Sec3Title" type="Label" parent="Modals/HowToPlayModal/Panel/VBox/Scroll/ContentVBox" unique_id=1876399955]
